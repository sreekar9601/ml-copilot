# Google Gemini API Key (required)
GOOGLE_API_KEY=your_google_api_key_here

# Qdrant Cloud Configuration (for production)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=ml_docs

# Security Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,*.yourdomain.com,your-app.railway.app
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Local Data Storage (fallback/development)
DATA_DIR=./data

# SQLite database file name
SQLITE_DB=bm25.db

# Embedding model
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1

# Chunk settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Search settings
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
RRF_K=60

# ============================================
# NEW: Agentic System Configuration (v3.0)
# ============================================

# Agent LLM Models
AGENT_ORCHESTRATOR_MODEL=gemini-2.5-flash
AGENT_SPECIALIST_MODEL=gemini-flash-1.5

# Agent Behavior
AGENT_MAX_ITERATIONS=10
AGENT_MAX_COST_PER_SESSION=0.50
AGENT_ENABLE_REFLECTION=true

# Memory Backend (sqlite or redis)
AGENT_MEMORY_BACKEND=sqlite
AGENT_MEMORY_DB_PATH=./data/agent_memory.db
REDIS_URL=redis://localhost:6379

# Observability (optional)
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=ml-copilot-v3
LANGSMITH_TRACING=true

# Code Execution (optional - E2B sandbox)
E2B_API_KEY=your-e2b-key-here
AGENT_SANDBOX_TIMEOUT=30
AGENT_ENABLE_CODE_EXECUTION=true

# Web Search (optional - Tavily)
TAVILY_API_KEY=your-tavily-key-here
AGENT_ENABLE_WEB_SEARCH=true

