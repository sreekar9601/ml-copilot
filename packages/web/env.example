# Environment Variables for ML Copilot Frontend
# Copy this file to .env.local for local development

# API Configuration
# For local development (points to local backend on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production deployment, set this to your Railway backend URL:
# NEXT_PUBLIC_API_URL=https://ml-copilot-production.up.railway.app

# Note: Never commit production URLs to source code!
# Always use environment variables for sensitive configuration.
